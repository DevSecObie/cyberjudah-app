{
  "name": "cyberjudah-app",
  "main": "src/runtime/cyberJudahStaticWorker.ts",
  "compatibility_date": "2026-08-19",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "api.cyberjudah.io",
      "custom_domain": true
    },
    {
      "pattern": "assets.cyberjudah.io",
      "custom_domain": true
    },
    {
      "pattern": "media.cyberjudah.io",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".local/cyberjudah-static/UNSTAGED/assets",
    "run_worker_first": true,
    "not_found_handling": "none",
    "html_handling": "none"
  },
  "vars": {
    "FIREBASE_APP_CHECK_PROJECT_NUMBER": "979802439968",
    "FIREBASE_APP_CHECK_ALLOWED_APP_IDS": "1:979802439968:ios:9077ff814ea26ba4959745,1:979802439968:android:b612f73b49e4150c959745",
    "RESOURCE_WEB_ORIGINS": "https://cyberjudah.io"
  },
  "ratelimits": [
    {
      "name": "ARTIFACT_RATE_LIMITER",
      "namespace_id": "2711007701",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  }
}

{
  "name": "cyberjudah-resources-production",
  "main": "src/runtime/cyberjudahNaveWorker.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "minify": true,
  "vars": {
    "FIREBASE_APP_CHECK_PROJECT_NUMBER": "979802439968",
    "FIREBASE_APP_CHECK_ALLOWED_APP_IDS": "1:979802439968:ios:9077ff814ea26ba4959745",
    "RESOURCE_WEB_ORIGINS": "https://web.cyberjudah.io",
    "RESOURCE_ENVIRONMENT": "production",
    "SEARCH_ANALYTICS_ENABLED": "false"
  },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "4f55c4e8fbbb4d858603df7d2283ec7d" }],
  "ratelimits": [
    { "name": "READING_RATE_LIMITER", "namespace_id": "9798024399691", "simple": { "limit": 20000, "period": 60 } },
    { "name": "ORIGIN_READING_RATE_LIMITER", "namespace_id": "9798024399697", "simple": { "limit": 1000, "period": 60 } },
    { "name": "SEARCH_RATE_LIMITER", "namespace_id": "9798024399692", "simple": { "limit": 300, "period": 60 } }
  ]
}

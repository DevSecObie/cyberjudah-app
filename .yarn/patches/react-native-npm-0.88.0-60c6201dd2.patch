@@ -158,6 +158,15 @@ class Scheduler final : public UIManagerDelegate {
 
   mutable std::shared_mutex onSurfaceStartCallbackMutex_;
   std::vector<OnSurfaceStartCallback> onSurfaceStartCallbacks_;
+
+  // CyberJudah: invalidation token captured by value into lambdas deferred via
+  // runtimeScheduler_->scheduleRenderingUpdate. Set to true on delegate change
+  // or Scheduler destruction, so a lambda that outlives its captured raw
+  // delegate pointer no-ops instead of dereferencing dangling memory.
+  // Port of the guard React Native 0.86.3 had behind
+  // enableSchedulerDelegateInvalidation (facebook/react-native#56680).
+  std::shared_ptr<std::atomic<bool>> delegateInvalidated_ =
+      std::make_shared<std::atomic<bool>>(false);
 };
 

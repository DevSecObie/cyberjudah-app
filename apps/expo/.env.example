# App identity
APP_NAME=CyberJudah
BUNDLE_IDENTIFIER=io.cyberjudah.app

# Firebase config files
IOS_GOOGLE_SERVICES_FILE=./firebase/cyberjudah-production/GoogleService-Info.plist
ANDROID_GOOGLE_SERVICES_FILE=./firebase/cyberjudah/google-services.json

# Sentry auth token used by `update:*` scripts to upload OTA sourcemaps (keep it in .env, never commit)
SENTRY_AUTH_TOKEN=

# Public runtime config
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_DEEPL_AUTH_KEY=
# Public Resource API. Leave blank in development to use the simulator-safe local default.
EXPO_PUBLIC_RESOURCE_API_URL=https://api.cyberjudah.io

# Resource service browser CORS allowlist used when running the local service.
RESOURCE_WEB_ORIGINS="http://localhost:8081,https://bible.strong.app"

# Firebase Web app (required by Expo Web)
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyAqCIfm78KkoFq0UOszT5YJdpvD6jWqG9U
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=cyberjudah-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=cyberjudah-app
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=cyberjudah-app.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=979802439968
EXPO_PUBLIC_FIREBASE_APP_ID=1:979802439968:web:67bc0435f68d70a4959745
# GA4 Web stream measurement ID (G-...), required for browser analytics.
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Enable only for DebugView validation; leave false for normal development and production.
EXPO_PUBLIC_ANALYTICS_DEBUG="false"
EXPO_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
# Set to true/1 to boot the lightweight development dashboard instead of the full app.
EXPO_PUBLIC_PLAYGROUND=false
# Replays onboarding on every app launch without removing already installed resources.
EXPO_PUBLIC_FORCE_ONBOARDING="false"
# Makes development builds behave as if the device were offline.
EXPO_PUBLIC_FORCE_OFFLINE="false"
# Checks for, downloads, and applies an EAS Update automatically at app startup.
EXPO_PUBLIC_AUTOMATIC_UPDATES=false
EXPO_NO_BUNDLE_SPLITTING=true

# EAS Updates channel. Leave blank for local development.
EAS_BUILD_CHANNEL=production

# Play Store review scripts
PACKAGE_NAME=io.cyberjudah.app
GOOGLE_SERVICE_ACCOUNT_PATH="./scripts/google-service-account.json"

# Optional study assistant Worker base URL (public URL only, never the Gloo key)
EXPO_PUBLIC_AI_API_URL=
# Comma-separated Firebase UIDs used only to hide/show the beta UI.
# The Worker AI_ALLOWED_UIDS binding remains the authorization authority.
EXPO_PUBLIC_AI_BETA_UIDS=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=979802439968-9a7bjqbkbk1j367so9katebd1stpt17q.apps.googleusercontent.com
